{
  "name": "pub-skor",
  "version": "8.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "icons": "npm i --no-save @resvg/resvg-js@2 && node scripts/icons.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "places:ist": "npm i --no-save @duckdb/node-api && node scripts/places/build-istanbul.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "@netlify/identity": "^2.0.0",
    "@preact/signals": "^2.11.3",
    "gotrue-js": "^1.0.1",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-preact": "^1.52.0",
    "preact": "^11.0.0",
    "preact-iso": "^2.12.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
